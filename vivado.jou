reset
# 1. Link the design to your specific Spartan-7 part
link_design -part xc7s50csga324-1
# 2. Now the tile object will be findable
set tile [get_tiles MONITOR_BOT_X46Y79]
# 3. List all PIPs (Programmable Interconnect Points) in that tile
foreach pip [get_pips -of_objects $tile] {
    puts "$pip"
}
set site [get_sites XADC_X0Y0]
set tile_name "MONITOR_BOT_X46Y79"
foreach pin [get_site_pins -of_objects $site] {
    # 1. Get the physical node connected to the site pin
    set node [get_nodes -of_objects $pin]
    
    # 2. Find the wire segment of that node that lives specifically in your tile
    set wire [get_wires -of_objects $node -filter "TILE_NAME == $tile_name"]
    
    # 3. Get the pin direction
    set dir [get_property DIRECTION $pin]
    
    puts "$pin ($dir) -> Tile Wire: $wire"
}
reset
cd ~/nextpnr-xilinx
python3 << 'PYEOF'
import json, re
# Complete site pin data from Vivado TCL ground truth
# Format: pin_name -> (direction, tile_wire)
# tile_wire strips MONITOR_BOT_X46Y79/ prefix
vivado_pins = {}
raw = """CONVST IN MONITOR_CONVST
CONVSTCLK IN MONITOR_CONVSTCLK
DADDR0 IN MONITOR_DADDR0
DADDR1 IN MONITOR_DADDR1
DADDR2 IN MONITOR_DADDR2
DADDR3 IN MONITOR_DADDR3
DADDR4 IN MONITOR_DADDR4
DADDR5 IN MONITOR_DADDR5
DADDR6 IN MONITOR_DADDR6
DCLK IN MONITOR_DCLK
DEN IN MONITOR_DEN
DI0 IN MONITOR_DI0
DI1 IN MONITOR_DI1
DI2 IN MONITOR_DI2
DI3 IN MONITOR_DI3
DI4 IN MONITOR_DI4
DI5 IN MONITOR_DI5
DI6 IN MONITOR_DI6
DI7 IN MONITOR_DI7
DI8 IN MONITOR_DI8
DI9 IN MONITOR_DI9
DI10 IN MONITOR_DI10
DI11 IN MONITOR_DI11
DI12 IN MONITOR_DI12
DI13 IN MONITOR_DI13
DI14 IN MONITOR_DI14
DI15 IN MONITOR_DI15
DWE IN MONITOR_DWE
RESET IN MONITOR_RESET
VAUXN0 IN MONITOR_VAUXN0
VAUXN1 IN MONITOR_VAUXN1
