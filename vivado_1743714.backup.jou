# 1. Synthesize the test file
read_verilog /tmp/bufr_test.v
synth_design -top top -part xc7s50csga324-1
# 2. Force placement to see where the silicon actually puts them
place_design
# 3. Dump the Ground Truth data
puts "\n=================================================="
puts "            VIVADO PHYSICAL MAPPING               "
puts "=================================================="
foreach ref {BUFR BUFIO} {
    set cells [get_cells -hier -filter "REF_NAME == $ref"]
    if {[llength $cells] == 0} {
        puts "No cells found for $ref"
    } else {
        foreach cell $cells {
            set site [get_sites -of_objects $cell]
            puts "Primitive: $ref"
            puts "  Cell:      $cell"
            puts "  LOC:       [get_property LOC $cell]"
            puts "  BEL:       [get_property BEL $cell]"
            puts "  SITE_TYPE: [get_property SITE_TYPE $site]"
            puts "--------------------------------------------------"
        }
    }
}
# Clear previous state
close_project -quiet
# Synthesize and Place
read_verilog /tmp/bufr_test.v
synth_design -top top -part xc7s50csga324-1
place_design
# Extract the Physical Mapping
foreach ref {BUFR BUFIO} {
    set cells [get_cells -hier -filter "REF_NAME == $ref"]
    foreach cell $cells {
        puts "Primitive: $ref | LOC: [get_property LOC $cell] | BEL: [get_property BEL $cell] | SITE_TYPE: [get_property SITE_TYPE [get_sites -of_objects $cell]]"
    }
}
reset
# 1. Reset and Load
close_project -quiet
read_verilog /tmp/bufr_test.v
synth_design -top top -part xc7s50csga324-1
# 2. Place Design (This will now succeed because of the IDDR load)
place_design
# 3. Extract the Ground Truth
puts "\n=================================================="
puts "            VIVADO PHYSICAL MAPPING               "
puts "=================================================="
foreach ref {BUFR BUFIO} {
    set cells [get_cells -hier -filter "REF_NAME == $ref"]
    foreach cell $cells {
        set site [get_sites -of_objects $cell]
        puts "Primitive: $ref"
        puts "  LOC:       [get_property LOC $cell]"
        puts "  BEL:       [get_property BEL $cell]"
        puts "  SITE_TYPE: [get_property SITE_TYPE $site]"
        puts "--------------------------------------------------"
    }
}
reset
# Anchor the clock to a specific Clock-Capable (CC) pin
set_property PACKAGE_PIN L16 [get_ports clk_in]
set_property IOSTANDARD LVCMOS33 [get_ports clk_in]
# Run placement again
place_design
puts "\n=================================================="
puts "        SPARTAN-7 ARCHITECTURE AUDIT              "
puts "=================================================="
foreach type {BUFR BUFIO} {
    # Find the first available site of this type
    set test_site [lindex [get_sites -filter "SITE_TYPE == $type"] 0]
    
    if {$test_site == ""} {
        puts "ERROR: No sites found for type $type"
    } else {
        # Get all Basic Elements (BELs) inside that site
        set bels [get_bels -of_objects [get_sites $test_site]]
        puts "Site Type: $type"
        puts "  Example Site: $test_site"
        puts "  Internal BELs: $bels"
        
        # Check if there is a primary BEL matching the primitive name
        foreach b $bels {
             set b_type [get_property BEL_TYPE [get_bels $b]]
             puts "    BEL: $b (Type: $b_type)"
        }
        puts "--------------------------------------------------"
    }
}
reset
link_design -part xc7s50csga324-1
set xadc_site [get_sites -filter {SITE_TYPE == XADC}]
puts "XADC site: $xadc_site"
set tile [get_tiles -of_objects $xadc_site]
puts "Tile: $tile"
puts "Tile X: [get_property COLUMN $tile]"
puts "Tile Y: [get_property ROW $tile]"
# Get the grid coordinates for ROI string
puts "Grid X: [get_property GRID_POINT_X $tile]"
