foreach type {BUFR BUFIO} {
    # Find the first available site of this type
    set test_site [lindex [get_sites -filter "SITE_TYPE == $type"] 0]
    
    if {$test_site == ""} {
        puts "ERROR: No sites found for type $type"
    } else {
        # Get all Basic Elements (BELs) inside that site
        set bels [get_bels -of_objects [get_sites $test_site]]
        puts "Site Type: $type"
        puts "  Example Site: $test_site"
        puts "  Internal BELs: $bels"
        
        # Check if there is a primary BEL matching the primitive name
        foreach b $bels {
             set b_type [get_property BEL_TYPE [get_bels $b]]
             puts "    BEL: $b (Type: $b_type)"
        }
        puts "--------------------------------------------------"
    }
}
