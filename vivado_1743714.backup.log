# 3. Dump the Ground Truth data
puts "\n=================================================="

==================================================
puts "            VIVADO PHYSICAL MAPPING               "
            VIVADO PHYSICAL MAPPING               
puts "=================================================="
==================================================
foreach ref {BUFR BUFIO} {
    set cells [get_cells -hier -filter "REF_NAME == $ref"]
    if {[llength $cells] == 0} {
        puts "No cells found for $ref"
    } else {
        foreach cell $cells {
            set site [get_sites -of_objects $cell]
            puts "Primitive: $ref"
            puts "  Cell:      $cell"
            puts "  LOC:       [get_property LOC $cell]"
            puts "  BEL:       [get_property BEL $cell]"
            puts "  SITE_TYPE: [get_property SITE_TYPE $site]"
            puts "--------------------------------------------------"
        }
    }
}
