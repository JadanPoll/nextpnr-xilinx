reset
link_design -part xc7s50csga324-1
set xadc_site [get_sites -filter {SITE_TYPE == XADC}]
puts "XADC site: $xadc_site"
set tile [get_tiles -of_objects $xadc_site]
puts "Tile: $tile"
puts "Tile X: [get_property COLUMN $tile]"
puts "Tile Y: [get_property ROW $tile]"
# Get the grid coordinates for ROI string
puts "Grid X: [get_property GRID_POINT_X $tile]"
puts "Grid Y: [get_property GRID_POINT_Y $tile]"clear
